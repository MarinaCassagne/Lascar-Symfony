{% extends 'base.html.twig' %}

{% block title %}Moderation index{% endblock %}

{% block body %}
    <h1>Moderation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Motif</th>
                <th>Date_de_creation</th>
                <th>Canal_de_moderation</th>
                <th>Type_de_cible</th>
                <th>Action_de_moderation</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for moderation in moderations %}
            <tr>
                <td>{{ moderation.id }}</td>
                <td>{{ moderation.motif }}</td>
                <td>{{ moderation.dateDeCreation ? moderation.dateDeCreation|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ moderation.canalDeModeration }}</td>
                <td>{{ moderation.typeDeCible }}</td>
                <td>{{ moderation.actionDeModeration }}</td>
                <td>
                    <a href="{{ path('app_moderation_show', {'id': moderation.id}) }}">show</a>
                    <a href="{{ path('app_moderation_edit', {'id': moderation.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_moderation_new') }}">Create new</a>
{% endblock %}
