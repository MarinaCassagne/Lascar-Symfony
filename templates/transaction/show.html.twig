{% extends 'base.html.twig' %}

{% block title %}Transaction{% endblock %}

{% block body %}
    <h1>Transaction</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ transaction.id }}</td>
            </tr>
            <tr>
                <th>Reference_transaction</th>
                <td>{{ transaction.referenceTransaction }}</td>
            </tr>
            <tr>
                <th>Montant_transaction</th>
                <td>{{ transaction.montantTransaction }}</td>
            </tr>
            <tr>
                <th>Date_de_paiement</th>
                <td>{{ transaction.dateDePaiement ? transaction.dateDePaiement|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Statut_paiement</th>
                <td>{{ transaction.statutPaiement }}</td>
            </tr>
            <tr>
                <th>Moyen_paiement</th>
                <td>{{ transaction.moyenPaiement }}</td>
            </tr>
            <tr>
                <th>IdCompteStripe</th>
                <td>{{ transaction.idCompteStripe }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_transaction_index') }}">back to list</a>

    <a href="{{ path('app_transaction_edit', {'id': transaction.id}) }}">edit</a>

    {{ include('transaction/_delete_form.html.twig') }}
{% endblock %}
